# Used by docker-compose.yml when running the relay (backend + MongoDB) as a
# single self-hosted stack. Copy this to .env and set real values before
# running `docker compose up`.
JWT_SECRET=change-me-to-a-long-random-string
MONGO_ROOT_USERNAME=agentbridge
MONGO_ROOT_PASSWORD=change-me-to-a-long-random-string

# Optional: comma-separated browser origins allowed to use the relay.
CORS_ORIGIN=
