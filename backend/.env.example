PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/agentbridge
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated browser origins for a deployed web client. Leave unset for
# local development and native mobile clients. In production this MUST be
# set to your actual origin(s) - unset means "reflect any origin", which is
# unsafe once the API is reachable from the internet.
CORS_ORIGIN=

# Legacy single-shared-secret auth for agent/frontend sockets, kept for
# simple single-user self-hosted setups. Leave UNSET unless you specifically
# need it: any holder of this value can act as ANY agent or frontend client
# with no per-user scoping. Never set it on a multi-user or internet-facing
# deployment; prefer the per-agent device-pairing flow instead.
AGENT_TOKEN=
