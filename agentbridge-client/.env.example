# Copy this file to .env in whichever directory you run `npx agentbridge`
# from - dotenv reads .env from the current working directory.

BACKEND_URL=http://localhost:4000

# Leave unset on first run: the agent will print a pairing code, which you enter
# in the mobile app's "Add agent" screen. Only set this manually for local dev
# / self-hosting without going through pairing.
AGENT_TOKEN=

# Optional initial workspace; defaults to the OS home directory if unset.
# Change it anytime from the mobile app's workspace picker.
AGENT_CWD=

# Which CLI this agent wraps. "claude-code" (default) or "codex".
AGENT_KIND=claude-code

# The CLI binary to spawn. Defaults to "claude" for claude-code, "codex" for
# codex - only set this if that binary isn't on PATH under its usual name.
AGENT_BIN=

# Model override, passed through to the CLI. Leave unset to use its default.
AGENT_MODEL=

MAX_QUEUE=10

# For Claude Code: "default" prompts (via the approval hook) before every
# tool call; acceptEdits/bypassPermissions skip that for trusted,
# non-interactive setups. For Codex (which has no per-tool interactive
# approval - see README) this instead picks the upfront sandbox policy:
# default -> read-only, acceptEdits -> workspace-write,
# bypassPermissions -> danger-full-access.
PERMISSION_MODE=default

# Local-only HTTP server used to relay tool-use approval requests to the
# mobile app. If you run two agents on the same machine at once, give the
# second one a different port.
HOOK_SERVER_PORT=8787
