BACKEND_URL=http://localhost:4000
AGENT_TOKEN=change-me-shared-secret
# Optional initial workspace; defaults to the OS home directory if unset.
# Change it anytime from the mobile app's workspace picker.
AGENT_CWD=
CLAUDE_BIN=claude
CLAUDE_MODEL=
MAX_QUEUE=10
# "default" prompts (via the approval hook) for every tool call. Use acceptEdits/
# bypassPermissions only for trusted, non-interactive setups.
PERMISSION_MODE=default
# Local-only HTTP server used to relay Claude's per-action permission prompts
# to the mobile app for approval.
HOOK_SERVER_PORT=8787
